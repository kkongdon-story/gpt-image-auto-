{
  "appId": "story.kkongdon.cardnews.lite",
  "productName": "Cardnews Studio Lite",
  "directories": {
    "output": "release"
  },
  "publish": null,
  "files": [
    "dist/**",
    "dist-electron/electron/**",
    "package.json",
    "usage.html",
    "THIRD_PARTY_NOTICES.md",
    "fonts/**"
  ],
  "extraResources": [
    {
      "from": "resources/ffmpeg",
      "to": "ffmpeg",
      "filter": [
        "ffmpeg.exe",
        "ffprobe.exe",
        "ffmpeg.manifest.json",
        "LICENSE.txt",
        "README.md"
      ]
    }
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Cardnews-Studio-Lite-Setup-${version}.${ext}",
    "createDesktopShortcut": true,
    "oneClick": false,
    "perMachine": false
  }
}
