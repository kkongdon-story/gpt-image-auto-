{
  "name": "gpt-cardnews-auto",
  "version": "1.0.0",
  "description": "Deterministic Korean cardnews editor and renderer for Cardnews Studio.",
  "author": "Kkongdon",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "package:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test": "vitest --run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "story.kkongdon.cardnews",
    "productName": "Cardnews Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "usage.html",
      "THIRD_PARTY_NOTICES.md",
      "fonts/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Cardnews-Studio-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "oneClick": false,
      "perMachine": false
    }
  }
}
